# Local development secrets for `wrangler dev` / `vite dev`.
# Copy this file to `.dev.vars` (gitignored) and fill in real values.

# Required: better-auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional versioned secrets for key rotation ("<version>:<secret>", current first),
# e.g. BETTER_AUTH_SECRETS=2:<new>,1:<old>. Keep BETTER_AUTH_SECRET as the legacy key.
# BETTER_AUTH_SECRETS=

# Local ZPan URL.
BETTER_AUTH_URL=http://localhost:5185
TRUSTED_ORIGINS=http://localhost:5185
# Optional comma-separated hosts accepted by the Vite development server.
# Cloudflare Quick Tunnel (*.trycloudflare.com) is already allowed in development.
ZPAN_DEV_ALLOWED_HOSTS=

# Local ZPan Cloud URL.
ZPAN_CLOUD_URL=http://localhost:5186

# License signing public keys are hardcoded in server/domain/license-keys.ts and
# cannot be configured. A local Cloud must sign with the dev key (see CONTRIBUTING.md,
# "Local Pro testing"); its certificates are accepted only for loopback hosts.

# Explicit Node runtime only; Workers always use simulated D1.
# DATABASE_URL=./.local/node/zpan.db
